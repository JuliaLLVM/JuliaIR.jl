; CHECK-NEXT:    [[EH_FIELD_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 224
; CHECK-NEXT:    [[RESET_CTX_PREV:%.*]] = load atomic volatile ptr, ptr [[RESET_CTX_PTR]] monotonic, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[REGION_LIVE:%.*]] = icmp eq ptr [[RESET_CTX_PREV]], [[CANCEL_UCONTEXT]]
; CHECK-NEXT:    br i1 [[REGION_LIVE]], label %[[CANCEL_PT_CONT:.*]], label %[[CANCEL_ESTABLISH:.*]]
; CHECK:       [[CANCEL_ESTABLISH]]:
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[PTLS:%.*]] = load ptr, ptr [[PTLS_FIELD_PTR]], align 8
; CHECK-NEXT:    [[SAFEPOINT_ADDR:%.*]] = getelementptr inbounds i8, ptr [[PTLS]], i32 16
; CHECK-NEXT:    [[SAFEPOINT:%.*]] = load atomic ptr, ptr [[SAFEPOINT_ADDR]] monotonic, align 8
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    call void @julia.safepoint(ptr [[SAFEPOINT]])
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[TMP0:%.*]] = ptrtoint ptr [[CANCEL_UCONTEXT]] to i64
; CHECK-NEXT:    store atomic volatile i64 [[TMP0]], ptr [[CANCEL_UCONTEXT]] monotonic, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[SAVED_GCSTACK:%.*]] = load ptr, ptr [[PGCSTACK]], align 8
; CHECK-NEXT:    [[CANCEL_GCSTACK_SLOT:%.*]] = getelementptr i8, ptr [[CANCEL_UCONTEXT]], i64 8
; CHECK-NEXT:    store volatile ptr [[SAVED_GCSTACK]], ptr [[CANCEL_GCSTACK_SLOT]], align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[SAVED_EH:%.*]] = load ptr, ptr [[EH_FIELD_PTR]], align 8
; CHECK-NEXT:    [[CANCEL_EH_SLOT:%.*]] = getelementptr i8, ptr [[CANCEL_UCONTEXT]], i64 16
; CHECK-NEXT:    store volatile ptr [[SAVED_EH]], ptr [[CANCEL_EH_SLOT]], align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[CANCEL_MCTX:%.*]] = getelementptr i8, ptr [[CANCEL_UCONTEXT]], i64 24
; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @__sigsetjmp(ptr [[CANCEL_MCTX]], i32 0) #[[ATTR7]]
; CHECK-NEXT:    store atomic volatile ptr [[CANCEL_UCONTEXT]], ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    br label %[[CANCEL_PT_CONT]]
; CHECK:       [[CANCEL_PT_CONT]]:
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    ret void
;
entry:
  %pgcstack = call ptr @julia.get_pgcstack_or_new()
  %r = call i32 @julia.cancellation_point()
  ret void
}

; Accesses a reset could tear: stores (atomic or not), atomic read-modify-writes and
; volatile loads, calls of intrinsics other than the harmless ones (also the
; `llvm.julia.gc_preserve_*` markers, which have no intrinsic ID), untagged calls, and
; runtime calls even when tagged. The pass's own exemptions and tagged calls are not.
define void @unsafe_points(ptr %p, ptr addrspace(10) %obj, ptr addrspace(11) %derived) {
; CHECK-LABEL: define void @unsafe_points(
; CHECK-SAME: ptr [[P:%.*]], ptr addrspace(10) [[OBJ:%.*]], ptr addrspace(11) [[DERIVED:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CANCEL_UCONTEXT:%.*]] = alloca [224 x i8], align 8
; CHECK-NEXT:    [[BUF:%.*]] = alloca i64, align 8
; CHECK-NEXT:    [[PGCSTACK:%.*]] = call ptr @julia.get_pgcstack()
; CHECK-NEXT:    [[CURRENT_TASK:%.*]] = getelementptr i8, ptr [[PGCSTACK]], i64 -192
; CHECK-NEXT:    [[RESET_CTX_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 264
; CHECK-NEXT:    [[PTLS_FIELD_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 208
; CHECK-NEXT:    [[EH_FIELD_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 224
; CHECK-NEXT:    [[RESET_CTX_PREV:%.*]] = load atomic volatile ptr, ptr [[RESET_CTX_PTR]] monotonic, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[REGION_LIVE:%.*]] = icmp eq ptr [[RESET_CTX_PREV]], [[CANCEL_UCONTEXT]]
; CHECK-NEXT:    br i1 [[REGION_LIVE]], label %[[CANCEL_PT_CONT:.*]], label %[[CANCEL_ESTABLISH:.*]]
; CHECK:       [[CANCEL_ESTABLISH]]:
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[PTLS:%.*]] = load ptr, ptr [[PTLS_FIELD_PTR]], align 8
; CHECK-NEXT:    [[SAFEPOINT_ADDR:%.*]] = getelementptr inbounds i8, ptr [[PTLS]], i32 16
; CHECK-NEXT:    [[SAFEPOINT:%.*]] = load atomic ptr, ptr [[SAFEPOINT_ADDR]] monotonic, align 8
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    call void @julia.safepoint(ptr [[SAFEPOINT]])
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[TMP0:%.*]] = ptrtoint ptr [[CANCEL_UCONTEXT]] to i64
; CHECK-NEXT:    store atomic volatile i64 [[TMP0]], ptr [[CANCEL_UCONTEXT]] monotonic, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[SAVED_GCSTACK:%.*]] = load ptr, ptr [[PGCSTACK]], align 8
; CHECK-NEXT:    [[CANCEL_GCSTACK_SLOT:%.*]] = getelementptr i8, ptr [[CANCEL_UCONTEXT]], i64 8
; CHECK-NEXT:    store volatile ptr [[SAVED_GCSTACK]], ptr [[CANCEL_GCSTACK_SLOT]], align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[SAVED_EH:%.*]] = load ptr, ptr [[EH_FIELD_PTR]], align 8
; CHECK-NEXT:    [[CANCEL_EH_SLOT:%.*]] = getelementptr i8, ptr [[CANCEL_UCONTEXT]], i64 16
; CHECK-NEXT:    store volatile ptr [[SAVED_EH]], ptr [[CANCEL_EH_SLOT]], align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[CANCEL_MCTX:%.*]] = getelementptr i8, ptr [[CANCEL_UCONTEXT]], i64 24
; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @__sigsetjmp(ptr [[CANCEL_MCTX]], i32 0) #[[ATTR7]]
; CHECK-NEXT:    store atomic volatile ptr [[CANCEL_UCONTEXT]], ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    br label %[[CANCEL_PT_CONT]]
; CHECK:       [[CANCEL_PT_CONT]]:
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr [[BUF]])
; CHECK-NEXT:    call void @llvm.assume(i1 true)
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[TOK:%.*]] = call token (...) @llvm.julia.gc_preserve_begin(ptr addrspace(10) [[OBJ]])
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[P]], i8 0, i64 8, i1 false)
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[V:%.*]] = load volatile i64, ptr [[P]], align 4
; CHECK-NEXT:    [[W:%.*]] = load i64, ptr [[P]], align 4
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[O:%.*]] = atomicrmw add ptr [[P]], i64 1 monotonic, align 8
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[X:%.*]] = cmpxchg ptr [[P]], i64 0, i64 1 acq_rel monotonic, align 8
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    store atomic i64 0, ptr [[P]] release, align 8
; CHECK-NEXT:    store i64 0, ptr [[P]], align 4, !julia.reset_safe [[META3]]
; CHECK-NEXT:    call void @safe_call(), !julia.reset_safe [[META3]]
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[B:%.*]] = call ptr @ijl_box_int64(i64 1), !julia.reset_safe [[META3]]
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[C:%.*]] = call ptr @jl_breakpoint(ptr null), !julia.reset_safe [[META3]]
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[D:%.*]] = call ptr addrspace(10) (ptr, ptr addrspace(10), ...) @julia.call(ptr null, ptr addrspace(10) [[OBJ]]), !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[E:%.*]] = call ptr @julia.pointer_from_objref(ptr addrspace(11) [[DERIVED]])
; CHECK-NEXT:    [[F:%.*]] = call ptr @julia.gc_loaded(ptr addrspace(10) [[OBJ]], ptr [[P]])
; CHECK-NEXT:    call void @julia.safepoint(ptr [[P]])
; CHECK-NEXT:    [[G:%.*]] = call i32 @__sigsetjmp(ptr [[P]], i32 0)
; CHECK-NEXT:    [[H:%.*]] = call ptr @julia.gc_alloc_obj(ptr [[PGCSTACK]], i64 8, ptr null)
; CHECK-NEXT:    call void @julia.object_write_barrier(ptr addrspace(10) [[OBJ]], ptr addrspace(10) [[OBJ]])
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    call void @llvm.julia.gc_preserve_end(token [[TOK]])
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    ret void
;
entry:
  %buf = alloca i64
  %pgcstack = call ptr @julia.get_pgcstack()
  %r = call i32 @julia.cancellation_point()
  call void @llvm.lifetime.start.p0(ptr %buf)
  call void @llvm.assume(i1 true)
  %tok = call token (...) @llvm.julia.gc_preserve_begin(ptr addrspace(10) %obj)
  call void @llvm.memset.p0.i64(ptr %p, i8 0, i64 8, i1 false)
  %v = load volatile i64, ptr %p
  %w = load i64, ptr %p
  %o = atomicrmw add ptr %p, i64 1 monotonic
  %x = cmpxchg ptr %p, i64 0, i64 1 acq_rel monotonic
  store atomic i64 0, ptr %p release, align 8
  store i64 0, ptr %p, !julia.reset_safe !0
  call void @safe_call(), !julia.reset_safe !0
  %b = call ptr @ijl_box_int64(i64 1), !julia.reset_safe !0
  %c = call ptr @jl_breakpoint(ptr null), !julia.reset_safe !0
  %d = call ptr addrspace(10) (ptr, ptr addrspace(10), ...) @julia.call(ptr null, ptr addrspace(10) %obj), !julia.reset_safe !0
  %e = call ptr @julia.pointer_from_objref(ptr addrspace(11) %derived)
  %f = call ptr @julia.gc_loaded(ptr addrspace(10) %obj, ptr %p)
  call void @julia.safepoint(ptr %p)
  %g = call i32 @__sigsetjmp(ptr %p, i32 0)
  %h = call ptr @julia.gc_alloc_obj(ptr %pgcstack, i64 8, ptr null)
  call void @julia.object_write_barrier(ptr addrspace(10) %obj, ptr addrspace(10) %obj)
  call void @llvm.julia.gc_preserve_end(token %tok)
  ret void
}

; A function that may run in its caller's region (it is "julia.ipo_reset_safe") has no
; buffer of its own: only its calls close the region (runtime calls even when tagged),
; its stores don't, and its return doesn't. Allocations are annotated until the region
; is closed.
define ptr @ipo_reset_safe(ptr "gcstack" %pgcstack, i64 %v) "julia.ipo_reset_safe" {
; CHECK-LABEL: define ptr @ipo_reset_safe(
; CHECK-SAME: ptr "gcstack" [[PGCSTACK:%.*]], i64 [[V:%.*]]) #[[ATTR3:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CURRENT_TASK:%.*]] = getelementptr i8, ptr [[PGCSTACK]], i64 -192
; CHECK-NEXT:    [[RESET_CTX_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 264
; CHECK-NEXT:    [[PTLS_FIELD_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 208
; CHECK-NEXT:    [[EH_FIELD_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 224
; CHECK-NEXT:    store i64 [[V]], ptr [[PGCSTACK]], align 4
; CHECK-NEXT:    [[X:%.*]] = call ptr @julia.gc_alloc_obj(ptr [[PGCSTACK]], i64 8, ptr null), !julia.reset_region [[META3]]
; CHECK-NEXT:    call void @safe_call(), !julia.reset_safe [[META3]]
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[B:%.*]] = call ptr @ijl_box_int64(i64 [[V]]), !julia.reset_safe [[META3]]
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    call void @unsafe_call()
; CHECK-NEXT:    [[Y:%.*]] = call ptr @julia.gc_alloc_obj(ptr [[PGCSTACK]], i64 8, ptr null)
; CHECK-NEXT:    ret ptr [[B]]
;
entry:
  store i64 %v, ptr %pgcstack
  %x = call ptr @julia.gc_alloc_obj(ptr %pgcstack, i64 8, ptr null)
  call void @safe_call(), !julia.reset_safe !0
  %b = call ptr @ijl_box_int64(i64 %v), !julia.reset_safe !0
  call void @unsafe_call()
  %y = call ptr @julia.gc_alloc_obj(ptr %pgcstack, i64 8, ptr null)
  ret ptr %b
}

; Without anything to close the region for, only the annotation.
define ptr @ipo_reset_safe_annotation_only() "julia.ipo_reset_safe" {
; CHECK-LABEL: define ptr @ipo_reset_safe_annotation_only(
; CHECK-SAME: ) #[[ATTR3]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[PGCSTACK:%.*]] = call ptr @julia.get_pgcstack()
; CHECK-NEXT:    [[X:%.*]] = call ptr @julia.gc_alloc_obj(ptr [[PGCSTACK]], i64 8, ptr null), !julia.reset_region [[META3]]
; CHECK-NEXT:    call void @safe_call(), !julia.reset_safe [[META3]]
; CHECK-NEXT:    ret ptr [[X]]
;
entry:
  %pgcstack = call ptr @julia.get_pgcstack()
  %x = call ptr @julia.gc_alloc_obj(ptr %pgcstack, i64 8, ptr null)
  call void @safe_call(), !julia.reset_safe !0
  ret ptr %x
}

; Without a GC stack, or without points and "julia.ipo_reset_safe", nothing changes.
define void @ipo_reset_safe_without_gcstack() "julia.ipo_reset_safe" {
; CHECK-LABEL: define void @ipo_reset_safe_without_gcstack(
; CHECK-SAME: ) #[[ATTR3]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void @unsafe_call()
; CHECK-NEXT:    ret void
;
entry:
  call void @unsafe_call()
  ret void
}

; Allocations and write barriers may run with the region open: they don't close it, and
; they are marked for FinalLowerGC, which lowers them to entry points that close and
; reopen it themselves.
define void @region_annotations(ptr addrspace(10) %obj, ptr addrspace(11) %fld, ptr addrspace(13) %ld) {
; CHECK-LABEL: define void @region_annotations(
; CHECK-SAME: ptr addrspace(10) [[OBJ:%.*]], ptr addrspace(11) [[FLD:%.*]], ptr addrspace(13) [[LD:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CANCEL_UCONTEXT:%.*]] = alloca [224 x i8], align 8
; CHECK-NEXT:    [[PGCSTACK:%.*]] = call ptr @julia.get_pgcstack()
; CHECK-NEXT:    [[CURRENT_TASK:%.*]] = getelementptr i8, ptr [[PGCSTACK]], i64 -192
; CHECK-NEXT:    [[RESET_CTX_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 264
; CHECK-NEXT:    [[PTLS_FIELD_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 208
; CHECK-NEXT:    [[EH_FIELD_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 224
; CHECK-NEXT:    [[RESET_CTX_PREV:%.*]] = load atomic volatile ptr, ptr [[RESET_CTX_PTR]] monotonic, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[REGION_LIVE:%.*]] = icmp eq ptr [[RESET_CTX_PREV]], [[CANCEL_UCONTEXT]]
; CHECK-NEXT:    br i1 [[REGION_LIVE]], label %[[CANCEL_PT_CONT:.*]], label %[[CANCEL_ESTABLISH:.*]]
; CHECK:       [[CANCEL_ESTABLISH]]:
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[PTLS:%.*]] = load ptr, ptr [[PTLS_FIELD_PTR]], align 8
; CHECK-NEXT:    [[SAFEPOINT_ADDR:%.*]] = getelementptr inbounds i8, ptr [[PTLS]], i32 16
; CHECK-NEXT:    [[SAFEPOINT:%.*]] = load atomic ptr, ptr [[SAFEPOINT_ADDR]] monotonic, align 8
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    call void @julia.safepoint(ptr [[SAFEPOINT]])
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[TMP0:%.*]] = ptrtoint ptr [[CANCEL_UCONTEXT]] to i64
; CHECK-NEXT:    store atomic volatile i64 [[TMP0]], ptr [[CANCEL_UCONTEXT]] monotonic, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[SAVED_GCSTACK:%.*]] = load ptr, ptr [[PGCSTACK]], align 8
; CHECK-NEXT:    [[CANCEL_GCSTACK_SLOT:%.*]] = getelementptr i8, ptr [[CANCEL_UCONTEXT]], i64 8
; CHECK-NEXT:    store volatile ptr [[SAVED_GCSTACK]], ptr [[CANCEL_GCSTACK_SLOT]], align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[SAVED_EH:%.*]] = load ptr, ptr [[EH_FIELD_PTR]], align 8
; CHECK-NEXT:    [[CANCEL_EH_SLOT:%.*]] = getelementptr i8, ptr [[CANCEL_UCONTEXT]], i64 16
; CHECK-NEXT:    store volatile ptr [[SAVED_EH]], ptr [[CANCEL_EH_SLOT]], align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[CANCEL_MCTX:%.*]] = getelementptr i8, ptr [[CANCEL_UCONTEXT]], i64 24
; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @__sigsetjmp(ptr [[CANCEL_MCTX]], i32 0) #[[ATTR7]]
; CHECK-NEXT:    store atomic volatile ptr [[CANCEL_UCONTEXT]], ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    br label %[[CANCEL_PT_CONT]]
; CHECK:       [[CANCEL_PT_CONT]]:
; CHECK-NEXT:    [[X:%.*]] = call ptr @julia.gc_alloc_obj(ptr [[PGCSTACK]], i64 8, ptr null), !julia.reset_region [[META3]]
; CHECK-NEXT:    call void @julia.object_write_barrier(ptr addrspace(10) [[OBJ]], ptr addrspace(10) [[OBJ]]), !julia.reset_region [[META3]]
; CHECK-NEXT:    call void (ptr addrspace(10), ptr addrspace(11), ptr addrspace(10), ...) @julia.field_write_barrier.p11(ptr addrspace(10) [[OBJ]], ptr addrspace(11) [[FLD]], ptr addrspace(10) [[OBJ]]), !julia.reset_region [[META3]]
; CHECK-NEXT:    call void (ptr addrspace(10), ptr addrspace(13), ptr addrspace(10), ...) @julia.field_write_barrier.p13(ptr addrspace(10) [[OBJ]], ptr addrspace(13) [[LD]], ptr addrspace(10) [[OBJ]]), !julia.reset_region [[META3]]
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    ret void
;
entry:
  %pgcstack = call ptr @julia.get_pgcstack()
  %r = call i32 @julia.cancellation_point()
  %x = call ptr @julia.gc_alloc_obj(ptr %pgcstack, i64 8, ptr null)
  call void @julia.object_write_barrier(ptr addrspace(10) %obj, ptr addrspace(10) %obj)
  call void (ptr addrspace(10), ptr addrspace(11), ptr addrspace(10), ...) @julia.field_write_barrier.p11(ptr addrspace(10) %obj, ptr addrspace(11) %fld, ptr addrspace(10) %obj)
  call void (ptr addrspace(10), ptr addrspace(13), ptr addrspace(10), ...) @julia.field_write_barrier.p13(ptr addrspace(10) %obj, ptr addrspace(13) %ld, ptr addrspace(10) %obj)
  ret void
}

; A "julia.ipo_reset_safe" function with a point of its own is instrumented like any
; function with points, everywhere (its caller's region may be open from the start):
; its stores close the region too, and its returns tear it down.
define void @ipo_reset_safe_with_point(ptr %p) "julia.ipo_reset_safe" {
; CHECK-LABEL: define void @ipo_reset_safe_with_point(
; CHECK-SAME: ptr [[P:%.*]]) #[[ATTR3]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CANCEL_UCONTEXT:%.*]] = alloca [224 x i8], align 8
; CHECK-NEXT:    [[PGCSTACK:%.*]] = call ptr @julia.get_pgcstack()
; CHECK-NEXT:    [[CURRENT_TASK:%.*]] = getelementptr i8, ptr [[PGCSTACK]], i64 -192
; CHECK-NEXT:    [[RESET_CTX_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 264
; CHECK-NEXT:    [[PTLS_FIELD_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 208
; CHECK-NEXT:    [[EH_FIELD_PTR:%.*]] = getelementptr i8, ptr [[CURRENT_TASK]], i64 224
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    store i64 1, ptr [[P]], align 4
; CHECK-NEXT:    [[RESET_CTX_PREV:%.*]] = load atomic volatile ptr, ptr [[RESET_CTX_PTR]] monotonic, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    [[REGION_LIVE:%.*]] = icmp eq ptr [[RESET_CTX_PREV]], [[CANCEL_UCONTEXT]]
; CHECK-NEXT:    br i1 [[REGION_LIVE]], label %[[CANCEL_PT_CONT:.*]], label %[[CANCEL_ESTABLISH:.*]]
; CHECK:       [[CANCEL_ESTABLISH]]:
; CHECK-NEXT:    store atomic volatile ptr null, ptr [[RESET_CTX_PTR]] release, align 8, !julia.reset_safe [[META3]]
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
; CHECK-NEXT:    [[PTLS:%.*]] = load ptr, ptr [[PTLS_FIELD_PTR]], align 8
; CHECK-NEXT:    [[SAFEPOINT_ADDR:%.*]] = getelementptr inbounds i8, ptr [[PTLS]], i32 16
; CHECK-NEXT:    [[SAFEPOINT:%.*]] = load atomic ptr, ptr [[SAFEPOINT_ADDR]] monotonic, align 8
; CHECK-NEXT:    fence syncscope("singlethread") seq_cst
